# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth: root and control/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values never go in git, but the templates do
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local deploy target for scripts/update.ps1
deploy.config.json

# historical snapshots kept on disk for reference; not part of the build
/.codex-backups/

# scratch space
/tmp/

# per-machine tool settings
.claude/settings.local.json

# coding-assistant instructions; kept locally, not part of the game
/AGENTS.md
/CLAUDE.md
