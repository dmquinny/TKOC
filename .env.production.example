# Run `sh scripts/create-production-env.sh` on the server to create the real
# file at ../appdata/tkoc-modern/.env.production. Never commit or share it.
DATABASE_URL=mysql://tkoc:CHANGE_ME@127.0.0.1:3306/tkoc
JWT_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
TICK_INTERVAL_SECONDS=3600
TICK_POLL_SECONDS=30
TICK_MAX_CATCH_UP=24
ENABLE_ADMIN_START_FRESH=true
PORT=3400
